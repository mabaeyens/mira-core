FROM gemma4:26b

# Pin context to 64K. Takes precedence over OLLAMA_CONTEXT_LENGTH env var,
# guarding against any env misconfiguration.
PARAMETER num_ctx 65536

# Keep the first 768 tokens (system prompt) pinned in the KV cache across turns.
# Without this, llama.cpp re-prefills the system prompt on every request.
PARAMETER num_keep 768

# kv_cache_type (q4_k) and flash_attn are set via OLLAMA_KV_CACHE_TYPE and
# OLLAMA_FLASH_ATTENTION in ~/.zprofile — no Modelfile param needed.
