# Mira local configuration — copy to mira.yaml and edit.
# mira.yaml is git-ignored; mira.yaml.example is committed.
# All fields are optional; omit any to keep the built-in default.

# ── Access control ─────────────────────────────────────────────────────────────
# Shared secret required by every API route (sent as `Authorization: Bearer <token>`).
# Leave unset for a private machine: the server then binds 127.0.0.1 only and refuses
# to expose a non-loopback interface. To reach Mira remotely you MUST set a token here
# (or via the MIRA_TOKEN env var) — the /chat endpoint can run shell commands and
# read/write files, so an unauthenticated open bind is never allowed.
# IMPORTANT: this file then holds a secret — `chmod 600 mira.yaml`.
# Generate one with: openssl rand -hex 32
# auth_token: "choose-a-long-random-string"

# Source-IP allowlist (defense-in-depth). With a token set, HTTP :8000 stays loopback
# and HTTPS :8443 binds the Tailscale interface only, so the default list below is all
# you need. To opt back into plain-WiFi LAN access (PLAINTEXT — sniffable; see
# docs/remote-access.md), add your LAN subnet here AND set MIRA_HOST=0.0.0.0.
# allowed_source_cidrs: ["127.0.0.0/8", "::1/128", "100.64.0.0/10"]

# Host header allowlist. Loopback and any IP inside allowed_source_cidrs are accepted
# automatically; a NAME is not. The Tailscale cert is issued for the MagicDNS name only,
# so remote clients must connect by name — and if that name isn't listed here the server
# answers 403 on an otherwise healthy connection, which clients report as "cannot reach
# server". Set this whenever you connect remotely. `setup.sh --with-tailscale <host>`
# fills it in for you.
# allowed_hosts:
#   - your-mac.tailXXXX.ts.net

# ── LLM backend ──────────────────────────────────────────────────────────────
# Recommended: mira-mlx (Mira's own inference server — bundled, no separate app to
# install; RAM-aware sizing, disk-backed prompt cache). Supports Qwen3.6 (MoE, the
# primary default) and Mistral-family models (e.g. Ministral 3 14B), incl. tool-calling.
# Alternatives:
#   - omlx: separate GUI app with its own model library; KV cache held in RAM → ~0ms TTFT
#   - vllm-mlx: patched Mistral tool-call parser; another option for the Mistral family
#   - mlx-lm: stock mlx-lm server, no mira-mlx extras (RAM-aware sizing, disk cache, stats)
# The dflash and ollama backends were removed on 2026-08-01. Everything they
# served runs on one of the four above.
backend: mira-mlx             # mira-mlx | omlx | mlx-lm | vllm-mlx
model: mlx-community/Qwen3.6-35B-A3B-4bit   # mlx-community repo id (mira-mlx/mlx-lm/vllm-mlx);
                                             # omlx wants its own model name instead, e.g. Qwen3.6-35B-A3B
host: http://localhost:8080  # every backend listens here; only one runs at a time

# ── Model picker presets ──────────────────────────────────────────────────────
# Named backend+model combinations shown in the iOS/macOS model picker.
# Edit freely — the app reads this list on every picker open (no app update needed).
# Omit this section to fall back to the built-in preset list.
backends:
  - id: mira-mlx-qwen3
    label: "Qwen3.6 35B (mira-mlx)"
    backend: mira-mlx
    model: mlx-community/Qwen3.6-35B-A3B-4bit
    context_window: 65536
  - id: mira-mlx-ministral3-14b
    label: "Ministral 3 14B (mira-mlx)"
    backend: mira-mlx
    model: mlx-community/Ministral-3-14B-Instruct-2512-4bit
    context_window: 65536
  - id: omlx-qwen3
    label: "Qwen3.6 35B (omlx)"
    backend: omlx
    model: Qwen3.6-35B-A3B
    context_window: 131072

# ── Embedding model (for RAG) ─────────────────────────────────────────────────
embed_model: nomic-ai/nomic-embed-text-v1.5   # HuggingFace model; downloaded once and cached locally

# ── RAG reranker ──────────────────────────────────────────────────────────────
# reranker_backend: qwen3 (default) uses Qwen3-Reranker-0.6B-4bit via mlx (~0.35 GB RAM,
# scores 0–1). crossencoder uses ms-marco-MiniLM-L-6-v2 via sentence-transformers (CPU).
reranker_backend: qwen3
reranker_model: mlx-community/Qwen3-Reranker-0.6B-4bit

# ── Context window ────────────────────────────────────────────────────────────
# gemma4:26b: 65536 tokens (64K) - optimal for M5 with 32GB RAM
# Qwen3.6-35B-A3B: 262144 tokens (256K) - requires >32GB RAM for best performance
context_window: 65536

# Thinking mode: adaptive (heuristic per request) | always | never
# adaptive: enables thinking for complex/reasoning requests, skips for simple ones
thinking_mode: adaptive

# ── Search ───────────────────────────────────────────────────────────────────
# Brave Search API key. When set, Brave is the primary web-search provider;
# DuckDuckGo (ddgs) is the no-key fallback used if this is empty or Brave errors.
# Get a key at https://api.search.brave.com — Free tier: 2,000 queries/month, ~1 query/sec.
# Can also be set via the BRAVE_API_KEY environment variable.
# This file is the committed template — keep the placeholder; put the real key in
# mira.yaml (git-ignored) or the env var, never here.
brave_api_key: "your-brave-search-api-key-here"

# ── CLI paths ─────────────────────────────────────────────────────────────────
# Absolute paths to inference server binaries on your machine.
# Run `which mlx_lm.server` / `which vllm-mlx` to find them.
# omlx_cli is fixed at /Applications/oMLX.app/... for all macOS installs.
# Omit any entry to use the built-in default.
# paths:
#   mlx_lm_cli: /path/to/mlx_lm.server       # e.g. ~/.local/bin/mlx_lm.server
#   omlx_cli: /Applications/oMLX.app/Contents/MacOS/omlx-cli  # same for all macOS

# ── Inference tuning (mira-mlx and mlx-lm only — ignored by omlx) ──
# prefill_step_size: tokens processed per prefill chunk.
# Valid powers of 2: 256 | 512 | 1024 | 2048 (2048 is experimental on 32GB RAM).
prefill_step_size: 1024

# mira_mlx_kv_bits: quantize mira-mlx's KV cache to this many bits (opt-in;
# unset/null = today's unquantized fp16 cache). Only 8 is numerically validated
# (mlx-lm fork's own test suite, rtol=4e-2) — trades a small amount of accuracy
# for ~1.6-2x more usable context window / concurrent-request headroom on
# RAM-constrained Macs. 4-bit is unproven anywhere in this codebase; treat as
# experimental if you try it.
# mira_mlx_kv_bits: 8

# mira_mlx_kv_group_size: quantization group size for mira_mlx_kv_bits (default 64).
mira_mlx_kv_group_size: 64

# mira_mlx_vision: read screenshots as images instead of running them through
# OCR. Off by default. Only works on a checkpoint that actually ships a vision
# tower; Qwen3.6-35B-A3B-4bit does, and it costs about 0.89GB resident plus
# roughly 0.4GB of forward activations. A 640x480 image spends 300 context
# tokens, 1024x768 spends 768.
#
# With this off nothing about vision is imported, and images keep taking the
# OCR path (which needs tesseract, and is cheaper for text-heavy screenshots
# anyway). With it on, image turns skip the prompt cache, because an image is
# represented as N copies of one placeholder token id and two different
# screenshots of the same size would otherwise collide into a false cache hit.
#
# If the tower fails to load, the backend keeps serving text and says so in
# /v1/stats under `vision.error` rather than failing the request.
# mira_mlx_vision: false

# mira_mlx_profile_experts: log MoE expert-routing decisions (which experts
# fire per layer/token) to a JSONL file, for the expert-offloading go/no-go
# analysis (specs/moe-expert-offload-01-profiling.md). No-op on dense models
# (e.g. Ministral 3 14B). Not meant to stay on permanently — enable for a
# deliberate profiling window against real traffic, then disable. Default: off.
# mira_mlx_profile_experts: true

# mira_mlx_expert_profile_path: where to write the JSONL log when
# mira_mlx_profile_experts is on. Default: <data dir>/expert_profile/<unix-ts>.jsonl
# mira_mlx_expert_profile_path: /path/to/expert_profile.jsonl

# mira_mlx_expert_offload: MoE expert disk offloading. Only
# `mira_mlx_resident_expert_fraction` of each MoE layer's experts stay resident;
# the rest are fetched on demand from the model's own safetensors shards (no
# repacking, no separate cache dir) and LRU-evicted. core/hardware.py sizes
# context/prompt-cache budgets against the reduced footprint automatically.
# It makes a model whose expert table exceeds unified memory runnable at all,
# but has a REAL throughput cost (measured ~5x slower decode, ~8-12x slower
# prefill on Qwen3.6-35B-A3B: a diverse prefill touches nearly every expert and
# the resident fraction can't hold that working set). No-op on dense models.
# Requires the mira-core-pin mlx-lm fork's enable_offload().
#   auto (default) — offload ONLY when the fully-resident model would not fit,
#                    decided per-model at launch; models that fit run at full
#                    speed, larger-than-DRAM models offload to run at all.
#   on / true      — always offload (trade speed for RAM headroom).
#   off / false    — never offload (fully resident, pre-offload path).
mira_mlx_expert_offload: auto
#
# mira_mlx_resident_expert_fraction: resident fraction USED when offload is on
# (default 0.3). Lower = less RAM, more cold-prefill misses; higher = more RAM,
# fewer misses. >= 1.0 keeps everything resident (same as offload off).
mira_mlx_resident_expert_fraction: 0.3
#
# mira_mlx_expert_ram_aware: in `auto`, when a model offloads because it wouldn't
# fit fully resident, size the resident fraction to available RAM instead of the
# flat fraction above — an over-DRAM model otherwise leaves memory idle (8-bit
# Qwen3.6 peaks ~12.7GB on a 32GB Mac at 0.3). Sizing to keep peak near 55% of RAM
# raises the 8-bit to 0.45: measured +12% decode AND +9% prefill, no quality
# change. The fraction above is the floor (sizing only ever raises it). Default
# true; false = flat fraction everywhere.
mira_mlx_expert_ram_aware: true

# ── Performance tips ─────────────────────────────────────────────────────────
# mira-mlx sizes its context window, prompt-cache pool and Metal cache limit from
# the RAM it actually finds (core/hardware.py), so there is nothing to tune by
# hand for a normal install. The knobs above are the ones worth touching:
# mira_mlx_kv_bits: 8 buys roughly 1.9x the context for a small accuracy cost,
# and mira_mlx_expert_offload lets a model larger than RAM open at all.
