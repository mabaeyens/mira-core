# Mira local configuration — copy to mira.yaml and edit.
# mira.yaml is git-ignored; mira.yaml.example is committed.
# All fields are optional; omit any to keep the built-in default.

# ── LLM backend ──────────────────────────────────────────────────────────────
# For MacBook Pro M5 with 32GB RAM:
#   - Use Ollama backend (oMLX requires >32GB RAM for MLX backend)
#   - gemma4:26b is ~11-23x faster than qwen3.6:latest on M5 hardware
#   - qwen3.6:35b-a3b is available but much slower on this hardware
backend: ollama              # ollama | omlx
model: gemma4:26b          # Default for Ollama; oMLX model: Qwen3.6-35B-A3B
                                # For Qwen3 on Ollama, use: qwen3.6:35b-a3b or qwen3.6:27b
host: http://localhost:11434 # Ollama default port

# ── Embedding model (for RAG) ─────────────────────────────────────────────────
embed_model: nomic-ai/nomic-embed-text-v1.5   # HuggingFace model; downloaded once and cached locally

# ── RAG reranker ──────────────────────────────────────────────────────────────
# reranker_backend: qwen3 (default) uses Qwen3-Reranker-0.6B-4bit via mlx (~0.35 GB RAM,
# scores 0–1). crossencoder uses ms-marco-MiniLM-L-6-v2 via sentence-transformers (CPU).
reranker_backend: qwen3
reranker_model: mlx-community/Qwen3-Reranker-0.6B-4bit

# ── Context window ────────────────────────────────────────────────────────────
# gemma4:26b: 65536 tokens (64K) - optimal for M5 with 32GB RAM
# Qwen3.6-35B-A3B: 262144 tokens (256K) - requires >32GB RAM for best performance
context_window: 65536

# Thinking mode: adaptive (heuristic per request) | always | never
# adaptive: enables thinking for complex/reasoning requests, skips for simple ones
thinking_mode: adaptive

# ── Search ───────────────────────────────────────────────────────────────────
# Brave Search API key (optional). When set, Brave is used before DuckDuckGo.
# Get a key at https://api.search.brave.com — Free tier: 2,000 queries/month.
# Can also be set via the BRAVE_API_KEY environment variable.
brave_api_key: "your-brave-search-api-key-here"

# ── Inference tuning ─────────────────────────────────────────────────────────
# prefill_step_size: tokens processed per prefill chunk (dflash + mlx-lm).
# Larger values reduce API round-trip overhead for long prompts.
# Valid powers of 2: 256 | 512 | 1024 | 2048 (2048 is experimental on 32GB RAM).
prefill_step_size: 1024

# dflash_diagnostics: write per-request structured logs to .artifacts/dflash/diagnostics/.
# Enables measuring real draft acceptance rate and verify block distribution under load.
# Values: off | basic (request/cache logs) | full (+memory waterfall). Default: off.
# Clear .artifacts/dflash/diagnostics/ after each bench session to avoid accumulation.
dflash_diagnostics: off

# ── Performance Tips ─────────────────────────────────────────────────────────
# For best performance with Ollama on MacBook Pro M5, add to ~/.zprofile:
#   export OLLAMA_CONTEXT_LENGTH=65536
#   export OLLAMA_FLASH_ATTENTION=1
#   export OLLAMA_NUM_PARALLEL=1
#   export OLLAMA_KV_CACHE_TYPE=q8_0
# Then restart Ollama.
