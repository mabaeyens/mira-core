# Mira local configuration — copy to mira.yaml and edit.
# mira.yaml is git-ignored; mira.yaml.example is committed.
# All fields are optional; omit any to keep the built-in default.

# ── Access control ─────────────────────────────────────────────────────────────
# Shared secret required by every API route (sent as `Authorization: Bearer <token>`).
# Leave unset for a private machine: the server then binds 127.0.0.1 only and refuses
# to expose a non-loopback interface. To reach Mira remotely you MUST set a token here
# (or via the MIRA_TOKEN env var) — the /chat endpoint can run shell commands and
# read/write files, so an unauthenticated open bind is never allowed.
# IMPORTANT: this file then holds a secret — `chmod 600 mira.yaml`.
# Generate one with: openssl rand -hex 32
# auth_token: "choose-a-long-random-string"

# Source-IP allowlist (defense-in-depth). With a token set, HTTP :8000 stays loopback
# and HTTPS :8443 binds the Tailscale interface only, so the default list below is all
# you need. To opt back into plain-WiFi LAN access (PLAINTEXT — sniffable; see
# docs/remote-access.md), add your LAN subnet here AND set MIRA_HOST=0.0.0.0.
# allowed_source_cidrs: ["127.0.0.0/8", "::1/128", "100.64.0.0/10"]

# Host header allowlist. Loopback and any IP inside allowed_source_cidrs are accepted
# automatically; a NAME is not. The Tailscale cert is issued for the MagicDNS name only,
# so remote clients must connect by name — and if that name isn't listed here the server
# answers 403 on an otherwise healthy connection, which clients report as "cannot reach
# server". Set this whenever you connect remotely. `setup.sh --with-tailscale <host>`
# fills it in for you.
# allowed_hosts:
#   - your-mac.tailXXXX.ts.net

# ── LLM backend ──────────────────────────────────────────────────────────────
# Recommended: mira-mlx (Mira's own inference server — bundled, no separate app to
# install; RAM-aware sizing, disk-backed prompt cache). Supports Qwen3.6 (MoE, the
# primary default) and Mistral-family models (e.g. Ministral 3 14B), incl. tool-calling.
# Alternatives:
#   - omlx: separate GUI app with its own model library; KV cache held in RAM → ~0ms TTFT
#   - vllm-mlx: patched Mistral tool-call parser; another option for the Mistral family
#   - mlx-lm: stock mlx-lm server, no mira-mlx extras (RAM-aware sizing, disk cache, stats)
# The dflash and ollama backends were removed on 2026-08-01. Everything they
# served runs on one of the four above.
backend: mira-mlx             # mira-mlx | omlx | mlx-lm | vllm-mlx
model: mlx-community/Qwen3.6-35B-A3B-4bit   # mlx-community repo id (mira-mlx/mlx-lm/vllm-mlx);
                                             # omlx wants its own model name instead, e.g. Qwen3.6-35B-A3B
host: http://localhost:8080  # every backend listens here; only one runs at a time

# ── Model picker presets ──────────────────────────────────────────────────────
# Named backend+model combinations shown in the iOS/macOS model picker.
# Edit freely — the app reads this list on every picker open (no app update needed).
# Omit this section to fall back to the built-in preset list.
backends:
  - id: mira-mlx-qwen3
    label: "Qwen3.6 35B (mira-mlx)"
    backend: mira-mlx
    model: mlx-community/Qwen3.6-35B-A3B-4bit
    context_window: 65536
  - id: mira-mlx-ministral3-14b
    label: "Ministral 3 14B (mira-mlx)"
    backend: mira-mlx
    model: mlx-community/Ministral-3-14B-Instruct-2512-4bit
    context_window: 65536
  - id: omlx-qwen3
    label: "Qwen3.6 35B (omlx)"
    backend: omlx
    model: Qwen3.6-35B-A3B
    context_window: 131072

# ── Embedding model (for RAG) ─────────────────────────────────────────────────
embed_model: nomic-ai/nomic-embed-text-v1.5   # HuggingFace model; downloaded once and cached locally

# ── RAG reranker ──────────────────────────────────────────────────────────────
# reranker_backend: qwen3 (default) uses Qwen3-Reranker-0.6B-4bit via mlx (~0.35 GB RAM,
# scores 0–1). crossencoder uses ms-marco-MiniLM-L-6-v2 via sentence-transformers (CPU).
reranker_backend: qwen3
reranker_model: mlx-community/Qwen3-Reranker-0.6B-4bit

# ── Context window ────────────────────────────────────────────────────────────
# gemma4:26b: 65536 tokens (64K) - optimal for M5 with 32GB RAM
# Qwen3.6-35B-A3B: 262144 tokens (256K) - requires >32GB RAM for best performance
context_window: 65536

# Thinking mode: adaptive (heuristic per request) | always | never
# adaptive: enables thinking for complex/reasoning requests, skips for simple ones
thinking_mode: adaptive

# How many tokens the model may spend inside its reasoning block before the
# closing tag is forced. It is NOT a stop: generation continues, so the model
# still gets to answer with whatever remains of max_output_tokens. 0 = uncapped.
#
# Enforced since 2026-08-12. Before that it was passed to the chat template as a
# variable Qwen3.6's template does not read, so it did nothing at any value.
#
# Why the default is what it is: decode time is 77-88% of a turn's wall clock and
# reasoning is a large share of what gets decoded, so a budget that binds cuts
# elapsed time almost one for one. But it binds by cutting the model off
# mid-thought, and answers cut short are a failure this project has already had
# once. 8192 essentially never binds (the worst turn measured spent ~5k); around
# 2048 it starts to. Change it and re-read a few long answers rather than
# trusting the clock.
max_thinking_tokens: 2048

# ── Sampling ─────────────────────────────────────────────────────────────────
# These defaults reproduce Mira's behaviour before 2026-08-09, when no sampling
# parameters existed and none were sent: the inference server fell back to 0.0
# for both, so every reply was greedy-decoded (always take the highest-probability
# token). Nothing here changes unless you change it.
#
# THEY ARE NOT WHAT THE MODEL ASKS FOR. Qwen3.6-35B-A3B ships its own
# generation_config.json specifying:
#
#     do_sample: true,  temperature: 1.0,  top_k: 20,  top_p: 0.95
#
# CHANGE ALL THREE TOGETHER OR NONE — because that is what the model author
# specifies, and top_k/top_p are the truncation that keeps sampling out of the
# distribution's tail. Temperature alone removes the safety without the guard.
#
# This is NOT backed by local measurement, and it would be easy to think it was.
# Two probe rounds on 2026-08-09 flatly contradicted each other on the same
# prompt and the same parameters: round 1 had temperature 1.0 alone repeating one
# sentence 303 times, round 2 had it producing the cleanest of five runs, while
# greedy went from best (round 1) to worst (round 2). Output is not reproducible
# across server processes on this M5, so n=1 per configuration ranks nothing.
# If you want a real answer, run repeats against a fixed prompt-cache state.
#
# To adopt the model's own recommendation, set all three:
#
#     temperature: 1.0
#     top_p: 0.95
#     top_k: 20
#
# Lower temperature is defensible for coding and tool-calling, where determinism
# matters more than variety — 0.0 is not absurd, it was simply never chosen.
# top_k is not an OpenAI-API parameter; Mira passes it via extra_body and
# mira-mlx honours it. 0 disables it. Backends other than mira-mlx may ignore it.
temperature: 0.0
top_p: 0.0
top_k: 0

# Seed. Leave unset (null) and the engine draws a fresh one per request, which is
# what makes regenerating a reply give you a different reply. Before this existed
# two identical requests came back byte-identical even at temperature 1.0, so
# "regenerate" returned the answer you had just rejected.
#
# Set an integer to pin it, for a run you want to be able to repeat. Two caveats
# worth knowing before trusting a pinned seed: it does nothing at temperature 0
# (the sampler is argmax and never draws), and it cannot make output reproducible
# while other requests are in flight — continuous batching changes the floating
# point arithmetic itself, so the same prompt can produce different text
# depending on what else the engine was doing.
# seed: 1234

# ── Runaway guard: repetition penalties ──────────────────────────────────────
# All off, which is how mira-mlx has always run — it called mlx-lm's
# make_logits_processors() with no arguments, so none of these could be turned on
# at all until 2026-08-12. Defaults below keep replies byte-identical.
#
# What they buy: a repetition loop is a high-probability region of the model's
# own distribution, so a penalty makes one less likely to be entered but cannot
# remove it. Worth setting if you see runaway repetition; not worth setting
# preemptively.
#
# What they cost: real output repeats too. This project's own traffic has
# produced 16 identical lines legitimately (a JSON config block) against 355 for
# the degenerate case, so a penalty aggressive enough to stop the second also
# taxes code, tables and lists. If you turn one on, start low and read a few long
# code replies before keeping it.
#
# repetition_penalty is multiplicative (1.0 = no effect, ~1.05-1.1 is a gentle
# start); presence and frequency are additive (0.0 = no effect). Each context
# size is how many recent tokens that penalty looks at, and only applies when its
# penalty is set.
# repetition_penalty: 1.05
# repetition_context_size: 256
# presence_penalty: 0.0
# presence_context_size: 20
# frequency_penalty: 0.0
# frequency_context_size: 20

# ── Search ───────────────────────────────────────────────────────────────────
# Brave Search API key. When set, Brave is the primary web-search provider;
# DuckDuckGo (ddgs) is the no-key fallback used if this is empty or Brave errors.
# Get a key at https://api.search.brave.com — Free tier: 2,000 queries/month, ~1 query/sec.
# Can also be set via the BRAVE_API_KEY environment variable.
# This file is the committed template — keep the placeholder; put the real key in
# mira.yaml (git-ignored) or the env var, never here.
brave_api_key: "your-brave-search-api-key-here"

# ── CLI paths ─────────────────────────────────────────────────────────────────
# Absolute paths to inference server binaries on your machine.
# Run `which mlx_lm.server` / `which vllm-mlx` to find them.
# omlx_cli is fixed at /Applications/oMLX.app/... for all macOS installs.
# Omit any entry to use the built-in default.
# paths:
#   mlx_lm_cli: /path/to/mlx_lm.server       # e.g. ~/.local/bin/mlx_lm.server
#   omlx_cli: /Applications/oMLX.app/Contents/MacOS/omlx-cli  # same for all macOS

# ── Inference tuning (mira-mlx and mlx-lm only — ignored by omlx) ──
# prefill_step_size: tokens processed per prefill chunk.
# Valid powers of 2: 256 | 512 | 1024 | 2048 (2048 is experimental on 32GB RAM).
prefill_step_size: 1024

# mira_mlx_kv_bits: quantize mira-mlx's KV cache to this many bits (opt-in;
# unset/null = today's unquantized fp16 cache). Only 8 is numerically validated
# (mlx-lm fork's own test suite, rtol=4e-2) — trades a small amount of accuracy
# for ~1.6-2x more usable context window / concurrent-request headroom on
# RAM-constrained Macs. 4-bit is unproven anywhere in this codebase; treat as
# experimental if you try it.
# mira_mlx_kv_bits: 8

# mira_mlx_kv_group_size: quantization group size for mira_mlx_kv_bits (default 64).
mira_mlx_kv_group_size: 64

# mira_mlx_vision: read screenshots as images instead of running them through
# OCR. Off by default. Only works on a checkpoint that actually ships a vision
# tower; Qwen3.6-35B-A3B-4bit does. The tower is about 0.89GB, but it is no
# longer loaded at startup: it loads on the first image turn and is released
# again once idle (see mira_mlx_vision_tower_idle_timeout), so turning this on
# costs nothing until an image actually arrives.
#
# With this off nothing about vision is imported, and images keep taking the
# OCR path (which needs tesseract, and is cheaper for text-heavy screenshots
# anyway). With it on, image turns skip the prompt cache, because an image is
# represented as N copies of one placeholder token id and two different
# screenshots of the same size would otherwise collide into a false cache hit.
#
# If the tower fails to load, the backend keeps serving text and says so in
# /v1/stats under `vision.error` rather than failing the request. The failure
# turns vision off for the process rather than being retried per image.
# mira_mlx_vision: false

# mira_mlx_vision_max_pixels: ceiling on an image's pixel count, and by far the
# biggest lever on what vision costs. The checkpoint asks for 16,777,216, which
# caps nothing in practice: a 5712x4284 phone photo survives at 16,170 image
# tokens, 243 seconds in the tower and 126MB of embeddings, for one image.
#
# The default of 1048576 (1 MP) holds any image to roughly 1,000 tokens and
# about 1.6 seconds, whatever came off the camera. That number was measured
# against real files rather than guessed: a game screenshot at 1 MP still read
# every UI label and skill name, so the obvious worry about losing small text
# did not hold up, and OCR covers the dense-text case anyway. What does soften
# is fine visual detail — the same screenshot gave "glowing blue and silver
# armor" at 2 MP and "blue skin, dark armor" at 1 MP.
#
# Raise to 2097152 (~2,000 tokens, ~4.4s) if that kind of detail matters. This
# only ever lowers the checkpoint's own ceiling, never raises it.
# mira_mlx_vision_max_pixels: 1048576

# mira_mlx_vision_tower_idle_timeout: seconds without an image before the
# tower's 0.89GB is released again. It reloads in well under two seconds and
# Metal kernels survive the round trip, so the next image after an idle stretch
# is barely slower. Set to 0 to keep the tower resident once loaded.
# mira_mlx_vision_tower_idle_timeout: 300

# memory_advisory_notifications: post a macOS notification when another app on
# this Mac pushes Mira's model out of memory. Default true. Worth having on
# because the state is otherwise invisible: macOS compresses the model out, your
# next reply takes about 15s instead of under a second, and that reply is itself
# what fixes it — so by the time you wonder what happened, it is already gone.
# Fires only on the transition into that state, at most once every 15 minutes.
# Set false if you would rather not be told.
# memory_advisory_notifications: false

# ── Opt-in performance flags ─────────────────────────────────────────────────
# All three ship OFF. Each is measured and working on the maintainer's machine;
# what they have not had is a week of ordinary use across different hardware,
# and each one changes a path every request goes through. Turn them on knowing
# that, or leave them and lose nothing you have today.

# boundary_snapshot: reuse the prompt cache across turns of the same
# conversation. Without it, plain multi-turn chat on Qwen3.6 re-prefills the
# entire conversation on every single turn — measured 2026-08-08, a 27,614-token
# second turn reused nothing and took 48.7s. Two things prevent the normal reuse
# paths from working on this model: its hybrid linear-attention cache cannot be
# trimmed at all, and the chat template's `<think>` scaffold means one turn's
# prompt is not a prefix of the next. So prefill is split at the history
# boundary and the state there is captured on the way past. Same turn with it
# on: 5.0s, reusing 27,500 of 27,614 tokens, for a 14ms snapshot cost.
# Agentic tool loops already reused well and are unaffected.
# boundary_snapshot: true

# proactive_decompress: fault the model back into RAM on the engine's idle
# branch when another app has had it compressed out, instead of leaving the bill
# for whoever asks next. Measured on a real eviction: the next reply cost 17.6s
# against a warm 0.45s, and nothing recovered on its own in the 12 minutes
# before it. Roughly memory-neutral, because emptying the compressor pays for
# most of the expansion. Skipped on battery, at critical pressure, and without
# headroom. The catch: a request arriving mid-touch waits behind it, and a full
# reclaim takes about 19.5s — never worse than doing nothing, since that request
# would have paid the fault-in itself, but it is not free either.
# proactive_decompress: true

# disk_prompt_cache: overflow evicted prompt-cache entries to disk. Off, and it
# is not merely unproven — it cannot work as built. A lookup is an exact match
# on a hash of the whole prompt, while an entry is keyed on the prompt plus
# everything generated, so a hit needs a byte-identical repeat of an entire
# conversation. Left on for three weeks it accumulated 39.75GB and served zero
# reads. Turning it on refills that. It stays here because a prefix-capable
# version is a real idea, not because this one is worth enabling.
# disk_prompt_cache: true

# mira_mlx_enable_tf32: let MLX use TF32 accumulation on the M5+ NAX kernels.
# Default true, which is also MLX's own default — it is stated here because the
# flag changes results, not just speed. Measured on an M5 (mlx 0.32.0), turning
# it off costs about 2.6x on fp32 matmul and 2.9x on the 4-bit MoE expert path,
# and buys back roughly 10 mantissa bits of fp32 accumulation. On a 4-bit model
# that accuracy sits well under the quantization noise, so the default keeps the
# speed. Decode is unaffected either way: the NAX path needs more than 16 rows
# in a batch to engage and decode runs one row at a time. Set false only to
# reproduce an upstream bit-equivalence test (see ml-explore/mlx#3897).
# Write it as a YAML bool, not a string — MLX parses the underlying env var as
# an integer, so the string "true" would read as OFF.
# mira_mlx_enable_tf32: false

# mira_mlx_profile_experts: log MoE expert-routing decisions (which experts
# fire per layer/token) to a JSONL file, for the expert-offloading go/no-go
# analysis (docs/moe-offload-case-study.md). No-op on dense models
# (e.g. Ministral 3 14B). Not meant to stay on permanently — enable for a
# deliberate profiling window against real traffic, then disable. Default: off.
# mira_mlx_profile_experts: true

# mira_mlx_expert_profile_path: where to write the JSONL log when
# mira_mlx_profile_experts is on. Default: <data dir>/expert_profile/<unix-ts>.jsonl
# mira_mlx_expert_profile_path: /path/to/expert_profile.jsonl

# mira_mlx_expert_offload: MoE expert disk offloading. Only
# `mira_mlx_resident_expert_fraction` of each MoE layer's experts stay resident;
# the rest are fetched on demand from the model's own safetensors shards (no
# repacking, no separate cache dir) and LRU-evicted. core/hardware.py sizes
# context/prompt-cache budgets against the reduced footprint automatically.
# It makes a model whose expert table exceeds unified memory runnable at all,
# but has a REAL throughput cost (measured ~5x slower decode, ~8-12x slower
# prefill on Qwen3.6-35B-A3B: a diverse prefill touches nearly every expert and
# the resident fraction can't hold that working set). No-op on dense models.
# Requires the mira-core-pin mlx-lm fork's enable_offload().
#   auto (default) — offload ONLY when the fully-resident model would not fit,
#                    decided per-model at launch; models that fit run at full
#                    speed, larger-than-DRAM models offload to run at all.
#   on / true      — always offload (trade speed for RAM headroom).
#   off / false    — never offload (fully resident, pre-offload path).
mira_mlx_expert_offload: auto
#
# mira_mlx_resident_expert_fraction: resident fraction USED when offload is on
# (default 0.3). Lower = less RAM, more cold-prefill misses; higher = more RAM,
# fewer misses. >= 1.0 keeps everything resident (same as offload off).
mira_mlx_resident_expert_fraction: 0.3
#
# mira_mlx_expert_ram_aware: in `auto`, when a model offloads because it wouldn't
# fit fully resident, size the resident fraction to available RAM instead of the
# flat fraction above — an over-DRAM model otherwise leaves memory idle (8-bit
# Qwen3.6 peaks ~12.7GB on a 32GB Mac at 0.3). Sizing to keep peak near 55% of RAM
# raises the 8-bit to 0.45: measured +12% decode AND +9% prefill, no quality
# change. The fraction above is the floor (sizing only ever raises it). Default
# true; false = flat fraction everywhere.
mira_mlx_expert_ram_aware: true

# ── Performance tips ─────────────────────────────────────────────────────────
# mira-mlx sizes its context window, prompt-cache pool and Metal cache limit from
# the RAM it actually finds (core/hardware.py), so there is nothing to tune by
# hand for a normal install. The knobs above are the ones worth touching:
# mira_mlx_kv_bits: 8 buys roughly 1.9x the context for a small accuracy cost,
# and mira_mlx_expert_offload lets a model larger than RAM open at all.
